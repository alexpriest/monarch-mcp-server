# ---------------------------------------------------------------------------
# Monarch MCP Server — environment
# Copy to .env for local runs. On Railway, set these as service variables.
# .env is gitignored; never commit real values.
# ---------------------------------------------------------------------------

# --- Monarch credentials (required) ----------------------------------------
# The server logs in with these and generates its own TOTP from the secret, so
# no authenticator app is in the loop. The resulting session token is cached and
# refreshed automatically on a 401.
MONARCH_EMAIL=you@example.com
MONARCH_PASSWORD=your-monarch-password
# Base32 secret from Monarch's 2FA setup screen ("can't scan the code?"),
# NOT a 6-digit code.
MONARCH_TOTP_SECRET=BASE32SECRET

# Optional: seed an existing session token instead of logging in on first use.
# MONARCH_TOKEN=

# Optional: override where the session token is cached. Defaults to
# $RAILWAY_VOLUME_MOUNT_PATH/monarch-token.json when a volume is mounted,
# otherwise ~/.monarch-mcp-token.json.
# MONARCH_TOKEN_CACHE_PATH=

# --- Transport --------------------------------------------------------------
# stdio | http | both. Defaults to http on Railway, stdio everywhere else.
TRANSPORT=http

# --- HTTP server (TRANSPORT=http|both) --------------------------------------
PORT=3000
# Defaults to 0.0.0.0 on Railway, 127.0.0.1 locally.
# HOST=127.0.0.1
# MCP_PATH=/mcp

# --- Auth on /mcp -----------------------------------------------------------
# Static bearer token — the simple path for local Claude Code / curl.
# Generate one: openssl rand -hex 32
AUTH_TOKEN=

# Passcode typed into the approval page during the claude.ai OAuth handshake.
# Required (with PUBLIC_URL) for claude.ai custom connector support.
MCP_OAUTH_PASSCODE=

# Externally-reachable origin, used for OAuth metadata. Auto-derived from
# RAILWAY_PUBLIC_DOMAIN when unset, but set it explicitly on Railway.
PUBLIC_URL=https://your-service.up.railway.app

# --- Misc -------------------------------------------------------------------
# NODE_ENV=production
#
# LOCAL TESTING ONLY — the SDK rejects a non-HTTPS issuer URL, which blocks
# running the OAuth layer against http://127.0.0.1. Never set this on Railway.
# MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=true
